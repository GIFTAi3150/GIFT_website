{
  "name": "gift-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "generate:icons": "node scripts/generate-icons.mjs",
    "start": "next start",
    "lint": "next lint",
    "prepare": "node scripts/setup-hooks.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "fix:encoding": "node scripts/check-encoding.mjs --write",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "news:draft": "node scripts/weekly-news.mjs",
    "seed:members": "node scripts/seed-members.mjs",
    "seed:positions": "node scripts/seed-positions.mjs",
    "test:security": "tsc src/lib/contact-security.ts --outDir node_modules/.cache/contact-security-tests --module commonjs --target ES2022 --skipLibCheck --esModuleInterop && node --test tests/contact-security.test.cjs tests/security-findings.test.cjs"
  },
  "dependencies": {
    "@notionhq/client": "^2.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@rive-app/react-canvas": "^4.34.2",
    "cobe": "^2.0.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.25",
    "ogl": "^1.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.0",
    "three": "^0.186.0",
    "html-to-text": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "^0.186.0",
    "autoprefixer": "10.6.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "playwright": "^1.63.0",
    "postcss": "8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
